# Docker doesn't read .gitignore, so this needs to repeat the entries
# that matter for a build context — most importantly `.env*`: without
# this, `COPY . .` in the Dockerfile would bake real local secrets into
# an image layer.
.env*
!.env.example

node_modules
.next
.git
.github

# Local-only artifacts that shouldn't affect Docker's build cache.
.playwright-mcp
test-results
playwright-report
blob-report
coverage
*.tsbuildinfo
next-env.d.ts

# Generated by `pnpm install` — the image runs its own install, so a
# host-machine copy (built for the host's OS/arch) must not be reused.
/src/db/generated

Dockerfile
.dockerignore
docker-compose.yml
