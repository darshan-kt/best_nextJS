// LMS core domain schema.
//
// Governing rules: §10 (Database), §11 (LMS Domain), §12/§13 (Roles),
// §14 (Enterprise Readiness), §18 (Quiz), §19 (Exercises), §41 (Migrations).
//
// Structural notes:
//   * The learning hierarchy is Course → Section → Lesson → ContentBlock.
//     Child entities are meaningless without their parent, so they cascade
//     on delete and inherit scope through the ownership chain rather than
//     duplicating ownership columns (§14).
//   * Course is the designated future organization-scope entity. No
//     `organizationId` exists yet — there is no Organization table to
//     reference — but nothing here prevents adding one as a nullable FK
//     later, which is a purely additive migration.
//   * PostgreSQL does not index foreign keys automatically, so every FK
//     that participates in a lookup carries an explicit index (§10).

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// §13. A user may hold several of these simultaneously (see UserRole).
enum RoleName {
  STUDENT
  INSTRUCTOR
  TUTOR
  MODERATOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// §14. `ORGANIZATION` is deliberately absent until the Organization
/// domain exists. Adding an enum value later is additive in PostgreSQL
/// (`ALTER TYPE ... ADD VALUE`) and does not rewrite the table.
enum CourseVisibility {
  PUBLIC
  PRIVATE
}

/// A learner's participation in a course.
///
/// Status rather than row deletion: unenrolling must not erase the fact
/// that someone once took the course, and Milestone 7 will hang progress
/// off the enrollment, which a delete would take with it. Keeping the row
/// also means the `[userId, courseId]` unique constraint still holds when
/// somebody re-enrolls.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// §11. New content types are expected; adding a value here plus a
/// renderer is the intended extension path.
enum ContentBlockType {
  TEXT
  IMAGE
  VIDEO
  QUIZ
  EXERCISE
  CODE
  CALLOUT
  FILE
  EMBED
}

/// §18. CODE / MATCHING / ORDERING / DRAG_DROP / SIMULATION are future
/// additions; question payloads are stored as JSON precisely so that new
/// types do not require a schema migration.
enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

/// §19.
enum EvaluationMethod {
  AUTOMATED
  AI_ASSISTED
  HUMAN_REVIEWED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  EVALUATED
}

/// §17. STUDENT and ASSISTANT cover this milestone's chat. TUTOR is
/// deliberately absent, not omitted by oversight: adding it later, when
/// human tutor escalation is actually built, is an additive enum value
/// (`ALTER TYPE ... ADD VALUE`), not a redesign of `Message`.
enum MessageSender {
  STUDENT
  ASSISTANT
}

// ---------------------------------------------------------------------------
// Identity & roles (§12, §13)
// ---------------------------------------------------------------------------

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  image String?

  /// Set by Auth.js when an email-based provider confirms ownership.
  /// Null for credentials sign-ups, which do not prove the address.
  emailVerified DateTime?

  /// scrypt hash of the account password (see features/auth/password.ts).
  /// Null for users who only ever sign in through an OAuth provider, so
  /// adding social login later requires no migration.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  roles               UserRole[]
  instructedCourses   Course[]             @relation("CourseInstructor")
  enrollments         Enrollment[]
  quizAttempts        QuizAttempt[]
  exerciseSubmissions ExerciseSubmission[]
  reviewedEvaluations ExerciseEvaluation[] @relation("EvaluationReviewer")
  conversations       Conversation[]

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Auth.js adapter tables
// ---------------------------------------------------------------------------
//
// Shape is dictated by @auth/prisma-adapter, including the snake_case
// column names, which mirror the OAuth token response fields verbatim.
// Do not rename them.
//
// The current Credentials provider uses none of these: it issues stateless
// JWT sessions. They exist now so that adding an OAuth or magic-link
// provider later is a configuration change rather than a migration.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Roles are a join table rather than a single column on User so that one
/// person can be e.g. both an instructor and a moderator without a
/// redesign (§13).
model UserRole {
  id     String   @id @default(cuid())
  userId String
  role   RoleName

  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Learning hierarchy (§11)
// ---------------------------------------------------------------------------

model Course {
  id          String  @id @default(cuid())
  /// Globally unique: courses are addressed as /courses/<slug> in the
  /// public catalogue. If organization-private catalogues later need
  /// per-organization slugs, this becomes a composite unique index — an
  /// index swap, not a data-destroying change.
  slug        String  @unique
  title       String
  subtitle    String?
  description String?

  status     CourseStatus     @default(DRAFT)
  visibility CourseVisibility @default(PUBLIC)

  /// Restrict rather than cascade: deleting a user must never silently
  /// destroy published course content and its learner history.
  instructorId String
  instructor   User   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections      Section[]
  enrollments   Enrollment[]
  conversations Conversation[]

  @@index([instructorId])
  // Catalogue listings filter on status + visibility and sort by recency.
  @@index([status, visibility, publishedAt])
}

/// §12. The link between a learner and a course, and the thing every
/// enrollment-gated permission check resolves against.
///
/// Deliberately carries a surrogate `id` even though `[userId, courseId]`
/// already identifies a row: Milestone 7 will reference it from
/// `LessonProgress(enrollmentId, lessonId)`. Progress is a fact about
/// someone's participation in a course, not about a user in the abstract,
/// so scoping it to the enrollment lets it inherit course scope through
/// the ownership chain (§14) and makes "this learner's progress in this
/// course" a single foreign-key lookup rather than a join back up through
/// lesson → section → course.
///
/// Course-level aggregates (percent complete, last-accessed lesson) are
/// additive columns here when Milestone 7 establishes they are needed.
/// They are not guessed at now.
model Enrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String

  status EnrollmentStatus @default(ACTIVE)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade on both sides: an enrollment is meaningless without the
  /// learner and the course it joins, unlike the course itself, which
  /// must survive the deletion of its author.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonProgress LessonProgress[]

  /// One enrollment per learner per course. Also the upsert key, which is
  /// what makes enrolling idempotent under a double-submitted form.
  @@unique([userId, courseId])
  // The unique index above already covers lookups keyed on userId, so only
  // the reverse direction — "who is enrolled in this course" — needs its
  // own index (§10).
  @@index([courseId, status])
}

model Section {
  id       String  @id @default(cuid())
  courseId String
  title    String
  summary  String?

  /// Ordering is intentionally not a unique constraint: drag-and-drop
  /// reordering would otherwise collide mid-transaction. Uniqueness is
  /// enforced by the application layer when persisting a new order.
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id        String  @id @default(cuid())
  sectionId String
  slug      String
  title     String
  summary   String?
  position  Int

  isPublished     Boolean @default(false)
  durationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section       Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentBlocks LessonContentBlock[]
  progress      LessonProgress[]

  @@unique([sectionId, slug])
  @@index([sectionId, position])
}

/// §44, Milestone 7. A learner's completion of one lesson, scoped to the
/// enrollment it happened under — exactly the shape the Milestone 5
/// comment on `Enrollment` anticipated.
///
/// The row's mere existence *is* "complete"; there is no in-progress
/// status to model at this level. Block-level partial completion (a video
/// resume position, say) is deliberately not here — it has no agreed
/// shape yet across content types, and guessing one now would guess wrong
/// for at least QUIZ and EXERCISE, which aren't functional until
/// Milestones 8 and 9 (§35).
///
/// No denormalized `percentComplete` on `Enrollment`: with course sizes
/// this small, `COUNT(*) WHERE enrollmentId = ?` against the index below
/// is one cheap, always-correct query. A cached aggregate would only ever
/// be a value that can drift from these rows, the actual source of truth
/// (§10).
model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  /// Cascade on both sides, matching `Enrollment` itself: a completion
  /// record is meaningless once either the enrollment or the lesson it
  /// refers to is gone.
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  /// One completion per lesson per enrollment. Also the upsert key —
  /// marking an already-complete lesson complete again must not create a
  /// duplicate row or error.
  @@unique([enrollmentId, lessonId])
  // Every read in this milestone asks "what has this enrollment
  // completed" — the reverse direction ("who has completed this lesson")
  // has no caller yet.
  @@index([enrollmentId])
}

/// §11. A lesson is an ordered list of content blocks, never a single
/// content type.
///
/// Lightweight block types (TEXT, IMAGE, VIDEO, CODE, CALLOUT, FILE,
/// EMBED) keep their payload in `data`, so new such types need no
/// migration. QUIZ and EXERCISE blocks instead point at real relational
/// models, because they own attempts, submissions and grading history
/// that must be queryable.
model LessonContentBlock {
  id       String           @id @default(cuid())
  lessonId String
  type     ContentBlockType
  position Int

  data Json?

  quizId     String? @unique
  exerciseId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz     Quiz?     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Quizzes (§18)
// ---------------------------------------------------------------------------

model Quiz {
  id          String  @id @default(cuid())
  title       String
  description String?

  /// Percentage (0-100) required to pass.
  passingScore     Int     @default(70)
  /// Null means unlimited attempts.
  maxAttempts      Int?
  shuffleQuestions Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentBlock LessonContentBlock?
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
}

model QuizQuestion {
  id       String       @id @default(cuid())
  quizId   String
  type     QuestionType
  position Int

  prompt      String
  explanation String?
  points      Int     @default(1)

  /// Type-specific payload: choice options, correct answers, matching
  /// pairs, and so on. Keeps new question types additive (§18).
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, position])
}

model QuizAttempt {
  id     String @id @default(cuid())
  quizId String
  userId String

  attemptNumber Int
  status        AttemptStatus @default(IN_PROGRESS)
  /// Percentage (0-100), populated once graded.
  score         Float?
  passed        Boolean?

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  // The composite unique below already indexes the (quizId, userId)
  // prefix, so "attempts by this learner on this quiz" needs no separate
  // index. Only the reverse lookup (all attempts by a learner) does.
  @@unique([quizId, userId, attemptNumber])
  @@index([userId])
}

model QuizAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  /// The learner's response; shape depends on the question type.
  response Json

  isCorrect     Boolean?
  pointsAwarded Float?
  feedback      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Practical exercises (§19)
// ---------------------------------------------------------------------------

model Exercise {
  id           String  @id @default(cuid())
  title        String
  instructions String?

  evaluationMethod EvaluationMethod @default(AUTOMATED)
  maxScore         Float            @default(100)

  /// Method-specific configuration: automated test cases, review rubric,
  /// AI grading guidance. Lets evaluation strategies evolve without a
  /// migration (§19).
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentBlock LessonContentBlock?
  submissions  ExerciseSubmission[]
}

model ExerciseSubmission {
  id         String @id @default(cuid())
  exerciseId String
  userId     String

  attemptNumber Int
  status        SubmissionStatus @default(DRAFT)

  /// Submitted work: code, prose, or references to stored media assets.
  /// Media itself lives behind the storage abstraction, not in the
  /// database (§32).
  content Json

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  exercise   Exercise            @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation ExerciseEvaluation?

  // As with QuizAttempt, the composite unique covers the
  // (exerciseId, userId) prefix.
  @@unique([exerciseId, userId, attemptNumber])
  @@index([userId])
}

/// §19: Exercise → Submission → Evaluation → Feedback. Modelled as a
/// separate entity (rather than columns on the submission) so that
/// automated, AI-assisted and human review all record their outcome the
/// same way.
model ExerciseEvaluation {
  id           String @id @default(cuid())
  submissionId String @unique

  method   EvaluationMethod
  score    Float?
  passed   Boolean?
  feedback String?

  /// Structured detail: test results, rubric breakdown, model rationale.
  details Json?

  /// Set for HUMAN_REVIEWED evaluations. Nulled rather than cascaded if
  /// the reviewer's account is removed, so learners keep their feedback.
  reviewerId String?

  evaluatedAt DateTime @default(now())

  submission ExerciseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User?              @relation("EvaluationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([reviewerId])
}

// ---------------------------------------------------------------------------
// Course AI assistant (§15, §16, §44 Milestone 10)
// ---------------------------------------------------------------------------

/// One learner's ongoing conversation with the AI assistant for one course
/// — scoped to (user, course), not (user, lesson): §16 frames this as a
/// *course* assistant, and a per-lesson reset would lose continuity the
/// moment a student asks a follow-up after moving to the next lesson.
///
/// No `organizationId`: exactly like `Enrollment`, this inherits scope
/// through `Course`, the designated future organization-scope entity
/// (§14). An enterprise customer wanting to audit assistant conversations
/// reaches them through the course they belong to, not a duplicated
/// ownership column here.
model Conversation {
  id       String @id @default(cuid())
  userId   String
  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages Message[]

  /// One conversation per learner per course — also the upsert key.
  @@unique([userId, courseId])
  // Every read is "this learner's conversation for this course", which the
  // unique index above already covers; no caller needs the reverse
  // direction ("every conversation in this course") yet.
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  sender         MessageSender
  content        String

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // The one read this milestone has: a conversation's messages in order.
  @@index([conversationId, createdAt])
}
