# Copy to `.env` and adjust for your environment.
# Every variable here must also be declared in src/config/env.ts (§30).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
#
# The bundled docker-compose.yml exposes Postgres on port 5433 (not the
# default 5432) so it cannot collide with another local Postgres instance.
DATABASE_URL="postgresql://lms:lms@localhost:5433/lms?schema=public"

# ---------------------------------------------------------------------------
# Authentication (Auth.js v5)
# ---------------------------------------------------------------------------
# Signs and encrypts session tokens. Generate a fresh one per environment:
#   openssl rand -base64 32
# Never reuse the development value in production.
AUTH_SECRET="replace-me-with-at-least-32-characters-of-random-data"

# Canonical origin, used to build OAuth callback URLs. Optional: Auth.js
# infers it in local development and on Vercel. Set it explicitly when
# running behind a reverse proxy or on a custom domain.
# AUTH_URL="https://example.com"

# ---------------------------------------------------------------------------
# Sign-in rate limiting
# ---------------------------------------------------------------------------
# Rolling window for counting failed sign-in attempts.
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Failed attempts per account before that account is throttled. This is the
# limit that actually stops a brute-force attack — it cannot be evaded by
# spoofing headers.
# AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=5

# Failed attempts per client IP. Defence in depth only: the client address
# is read from x-forwarded-for, which is forgeable unless a proxy you
# control overwrites it. Raise this if users share an egress IP.
# AUTH_RATE_LIMIT_MAX_PER_IP=20
