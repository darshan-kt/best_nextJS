# Copy to `.env` and adjust for your environment.
# Every variable here must also be declared in src/config/env.ts (§30).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
#
# The bundled docker-compose.yml exposes Postgres on port 5433 (not the
# default 5432) so it cannot collide with another local Postgres instance.
DATABASE_URL="postgresql://lms:lms@localhost:5433/lms?schema=public"

# Used only by `pnpm test:integration` (Milestone 11) — a separate
# DATABASE on the same local Postgres instance (not just a schema: the
# `@prisma/adapter-pg` driver adapter connects via a plain `pg.Pool`, which
# does not honor a `?schema=` query-string parameter, so two URLs differing
# only by `?schema=` silently land on the same `public` schema — confirmed
# the hard way when `pnpm test:integration`'s cleanup step truncated real
# dev data twice before this was caught). Create it once with:
#   docker exec lms-postgres psql -U lms -d postgres -c "CREATE DATABASE lms_test OWNER lms;"
# `pnpm test:integration` migrates it automatically before each run.
TEST_DATABASE_URL="postgresql://lms:lms@localhost:5433/lms_test"

# ---------------------------------------------------------------------------
# Authentication (Auth.js v5)
# ---------------------------------------------------------------------------
# Signs and encrypts session tokens. Generate a fresh one per environment:
#   openssl rand -base64 32
# Never reuse the development value in production.
AUTH_SECRET="replace-me-with-at-least-32-characters-of-random-data"

# Canonical origin. Optional in local development and on Vercel — Auth.js
# infers it there. REQUIRED everywhere else in production (see the check
# in src/config/env.ts): without it, Auth.js rejects every request with an
# UntrustedHost error. For an AWS/EC2 deploy, set this to that instance's
# real address, e.g. http://<ec2-public-ip>:3000.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sign-in rate limiting
# ---------------------------------------------------------------------------
# Rolling window for counting failed sign-in attempts.
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Failed attempts per account before that account is throttled. This is the
# limit that actually stops a brute-force attack — it cannot be evaded by
# spoofing headers.
# AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=5

# Failed attempts per client IP. Defence in depth only: the client address
# is read from x-forwarded-for, which is forgeable unless a proxy you
# control overwrites it. Raise this if users share an egress IP.
# AUTH_RATE_LIMIT_MAX_PER_IP=20

# ---------------------------------------------------------------------------
# Course AI assistant (Google Gemini — free tier for this milestone)
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey — no billing required for
# the free tier. Belongs only to features/ai/providers/gemini-provider.ts;
# swapping to a paid provider later means adding a new provider file, not
# touching this one.
GEMINI_API_KEY="replace-me"

# Overridable as Google's free-tier model lineup moves.
# GEMINI_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
# Chat rate limiting
# ---------------------------------------------------------------------------
# Rolling window for counting chat messages sent to the AI assistant.
# CHAT_RATE_LIMIT_WINDOW_SECONDS=3600

# Messages per student allowed inside the window — bounds worst-case
# spend/quota use per student, not a security defence like the auth limits
# above.
# CHAT_RATE_LIMIT_MAX_PER_USER=30

# ---------------------------------------------------------------------------
# Rate limiter backing store (Milestone 12)
# ---------------------------------------------------------------------------
# Backs src/server/rate-limit (sign-in throttling + chat rate limiting) and
# its own integration test (redis.integration.test.ts). `pnpm db:up` starts
# this alongside Postgres — docker-compose.yml exposes it on port 6380, not
# the default 6379, for the same reason Postgres uses 5433: no collision
# with another local Redis.
#
# Uncommented (unlike the rate limit thresholds above) so local dev runs
# the same Redis-backed limiter production does, rather than only meeting
# it for the first time in production. Leave it unset only if you
# deliberately want to exercise the in-memory fallback locally.
#
# REQUIRED in production — see the check in src/config/env.ts — because the
# in-memory limiter only sees its own process's traffic; under more than
# one instance, or under serverless/Lambda concurrency, it stops
# meaningfully enforcing anything. In AWS, this points at an ElastiCache
# for Redis endpoint instead.
REDIS_URL="redis://localhost:6380"
